NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Reemplazar por un secreto largo y aleatorio. No versionar el archivo .env.
JWT_SECRET=CAMBIAR_POR_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=8h

# Deben corresponder con la base y el usuario creados en MariaDB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_aplicacion
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA
DB_NAME=sistema_licoreria
DB_CONNECTION_LIMIT=10

# Herramientas y almacenamiento privado de respaldos. Usar rutas absolutas en producción.
DB_DUMP_EXECUTABLE=mysqldump
DB_RESTORE_EXECUTABLE=mysql
BACKUP_STORAGE_PATH=storage/backups
BACKUP_MAX_MANUAL=10
BACKUP_PROCESS_TIMEOUT_MS=300000
